# --- Build artifacts ---
.build/
dist/
*.o
*.swiftmodule
*.swiftdoc

# --- Tool / local caches ---
.serena/
.remember/
.DS_Store

# --- Large corpora (re-fetchable / regenerable) ---
# Swiss-Prot and its derived subsets are hundreds of MB and are re-fetchable.
# The 200-sequence query set is 300 KB and is what the quickstart, the public
# probe and every benchmark in the README actually run on, so it ships.
data/public_probe/*
!data/public_probe/unreviewed_uncharacterized_bacteria_200.fasta

# --- Perpetual worker runtime (local only) ---
state/*
!state/inbox/
state/inbox/*
!state/inbox/.gitkeep
!state/inbox/processed/
state/inbox/processed/*
!state/inbox/processed/.gitkeep
discoveries/ledger.db
discoveries/ledger.db-wal
discoveries/ledger.db-shm
discoveries/DISCOVERIES.md
discoveries/assets/*
!discoveries/assets/3Dmol-min.js
!discoveries/assets/3Dmol-LICENSE.txt
logs/*.log
# All new run products are local-only. Already-tracked historical examples stay
# tracked by Git, while future audit/custom run IDs cannot be added accidentally.
runs/*/
discoveries/*.tmp
discoveries/dashboard.html

# --- Optional Pfam profile database (re-downloadable, ~3 GB) ---
data/pfam/

# --- Bundled tool binaries (re-downloadable, kept on disk) ---
tools/**/*.tar.gz
tools/foldseek/foldseek/

# --- Python environments ---
.venv/
venv/
__pycache__/
*.pyc
