# --- Build artifacts ---
.build/
dist/
*.o
*.swiftmodule
*.swiftdoc

# --- Tool / local caches ---
.serena/
.remember/
.DS_Store

# --- Large corpora (re-fetchable / regenerable) ---
data/public_probe/

